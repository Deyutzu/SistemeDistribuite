@echo off
setlocal
set ECHIPA=%1
if "%ECHIPA%"=="" set ECHIPA=1

powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $team=%ECHIPA%; $tmp=Join-Path $env:TEMP ('dfs-integritate-' + [guid]::NewGuid().ToString('N')); $src=Join-Path $tmp 'src'; $out=Join-Path $tmp 'out'; $n1d=Join-Path $tmp 'n1'; $n2d=Join-Path $tmp 'n2'; $n3d=Join-Path $tmp 'n3'; $cmdFile=Join-Path $tmp 'cmds.txt'; [void](New-Item -ItemType Directory -Force -Path $src,$out,$n1d,$n2d,$n3d); $procs=@(); try { $procs += Start-Process java -ArgumentList ('-cp target\classes dfs.StorageNode --id n1 --port 7001 --dir \"' + $n1d + '\" --echipa ' + $team + ' --coordinator') -NoNewWindow -PassThru -RedirectStandardOutput (Join-Path $tmp 'n1.out') -RedirectStandardError (Join-Path $tmp 'n1.err'); $procs += Start-Process java -ArgumentList ('-cp target\classes dfs.StorageNode --id n2 --port 7002 --dir \"' + $n2d + '\" --echipa ' + $team) -NoNewWindow -PassThru -RedirectStandardOutput (Join-Path $tmp 'n2.out') -RedirectStandardError (Join-Path $tmp 'n2.err'); $procs += Start-Process java -ArgumentList ('-cp target\classes dfs.StorageNode --id n3 --port 7003 --dir \"' + $n3d + '\" --echipa ' + $team) -NoNewWindow -PassThru -RedirectStandardOutput (Join-Path $tmp 'n3.out') -RedirectStandardError (Join-Path $tmp 'n3.err'); Start-Sleep -Seconds 3; $rng=[System.Security.Cryptography.RandomNumberGenerator]::Create(); $nodes=@('n1','n2','n3'); $cmds=New-Object System.Collections.Generic.List[string]; $cmds.Add('nodes'); $idx=0; for($i=1;$i -le 100;$i++){ $sz=512+$i*2048; $buf=New-Object byte[] $sz; $rng.GetBytes($buf); $fn='fisier_' + $i + '.bin'; [System.IO.File]::WriteAllBytes((Join-Path $src $fn), $buf); $nd=$nodes[$idx]; $idx++; if($idx -ge 3){$idx=0}; $cmds.Add('put ' + $nd + ' ' + (Join-Path $src $fn)); }; $idx=0; for($i=1;$i -le 100;$i++){ $fn='fisier_' + $i + '.bin'; $nd=$nodes[$idx]; $idx++; if($idx -ge 3){$idx=0}; $cmds.Add('get ' + $nd + ' ' + $fn + ' ' + $out); }; $cmds.Add('exit'); [System.IO.File]::WriteAllLines($cmdFile, $cmds); $cp=Start-Process java -ArgumentList ('-cp target\classes dfs.Client --echipa ' + $team) -NoNewWindow -PassThru -Wait -RedirectStandardInput $cmdFile -RedirectStandardOutput (Join-Path $tmp 'client.out') -RedirectStandardError (Join-Path $tmp 'client.err'); $ok=0; $fail=0; for($i=1;$i -le 100;$i++){ $fn='fisier_' + $i + '.bin'; $f1=Join-Path $src $fn; $f2=Join-Path $out $fn; if((Test-Path $f2) -and ((Get-FileHash $f1 -Algorithm SHA256).Hash -eq (Get-FileHash $f2 -Algorithm SHA256).Hash)){ $ok++ } else { Write-Host ('Diferenta la ' + $fn); $fail++ } }; Write-Host ('Verificate 100 fisiere: ' + $ok + ' corecte, ' + $fail + ' diferite.'); if($fail -ne 0){ exit 1 } else { exit 0 } } finally { foreach($p in $procs){ if($p -and -not $p.HasExited){ Stop-Process -Id $p.Id -Force -ErrorAction SilentlyContinue; [void]$p.WaitForExit(1000) } }; Start-Sleep -Milliseconds 200; Remove-Item -Recurse -Force $tmp -ErrorAction SilentlyContinue }"
exit /b %errorlevel%
